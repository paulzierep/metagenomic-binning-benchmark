42:"$MM" run -p "$ENV" bwa index "$OUT/contigs.fa" 2>&1 | tail -2
43:"$MM" run -p "$ENV" bash -c "bwa mem -p -t 32 '$OUT/contigs.fa' '$READS' 2>'$OUT/logs/bwa.log' | samtools sort -@ 32 -o '$OUT/bamfiles/marine.bam' -"
