import csv
with open('medium_v11_20260924_checkm2_stats.csv', 'w', newline='') as f:
    writer = csv.writer(f)
    writer.writerow(['bin_id', 'completeness', 'contamination'])
    # Read quality_report.tsv and compute means
    with open('/vol/data/benchmark/runs/medium_v11_20260924/eval/checkm2/quality_report.tsv') as rf:
        reader = csv.DictReader(rf, delimiter='\t')
        rows = list(reader)
        n = len(rows)
        comp_sum = sum(float(r['Completeness']) for r in rows)
        cont_sum = sum(float(r['Contamination']) for r in rows)
        comp_mean = comp_sum / n
        cont_mean = cont_sum / n
        writer.writerow(['MEAN', comp_mean, cont_mean])
        writer.writerow(['COUNT', n, ''])
    print(f'CheckM2: {n} bins, mean completeness={comp_mean:.2f}%, mean contamination={cont_mean:.2f}%')
    
    # Also compute HQ/MQ from the data
    hq = sum(1 for r in rows if r.get('Additional_Notes','') != 'None' and 'HQ' in r.get('Additional_Notes',''))
    mq = sum(1 for r in rows if r.get('Additional_Notes','') != 'None' and 'MQ' in r.get('Additional_Notes',''))
    print(f'HQ={hq}, MQ={mq}')
"
