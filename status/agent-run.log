+  STATE=$(python3 -c "import json;print(json.load(open('$WORK/resp.json')).get('state',''))")
+  [ "$STATE" = "done" ] && break
+  sleep 3
+done
+[ "${STATE:-}" = "done" ] || die "deposition did not reach state=done (state=${STATE:-unknown})"
