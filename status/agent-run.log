import zlib, tarfile, io, gzip, struct, os

# Read the short reads tar.gz file
with open('/vol/data/datasets/cami_III/cami3_toy_human_gut_short_read_sample_0.tar.gz', 'rb') as f:
    raw = f.read()

# Decompress what we can (skip 10-byte gzip header)
dec = zlib.decompressobj(-zlib.MAX_WBITS)
decompressed = dec.decompress(raw[10:])

# Manual tar parsing to find and extract anonymous_reads.fq.gz
# and reads_mapping.tsv.gz

pos = 0
found_files = []

while pos < len(decompressed):
    header = decompressed[pos:pos+512]
    if len(header) < 512:
        break
    name = header[0:100].rstrip(b'\x00').decode('utf-8', errors='replace')
    if name.strip() == '':
        break
    size = int(header[124:136].rstrip(b'\x00').decode('utf-8', errors='replace'), 8)
    typeflag = header[156:157] if len(header) > 156 else b''
    
    if typeflag == b'0' or typeflag == b'\0':
        kind = 'file'
    elif typeflag == b'5':
        kind = 'dir'
    else:
        kind = f'type={typeflag}'
    
    if kind == 'file':
        file_start = pos + 512
        file_blocks = (size + 511) // 512
        file_end = file_start + file_blocks * 512
        file_data = decompressed[file_start:file_end]
        # Remove padding
        if size % 512 != 0:
            actual_data = file_data[:-((512 - size % 512) % 512)]
        else:
            actual_data = file_data
        
        found_files.append((name, actual_data))
        print(f'File: {name}, data size: {len(actual_data)}')
        
        # Try to decompress as gzip if this is .gz file
        if name.endswith('.gz'):
            print(f'  Attempting gzip decompression...')
            try:
                mgz = gzip.decompress(actual_data)
                print(f'  gzip success: {len(mgz)} bytes')
                # Save decompressed data
                base_name = name[:-3]  # remove .gz
                # Write to a temp file for later use
                out_path = f'/tmp/{os.path.basename(base_name)}.tmp'
                with open(out_path, 'wb') as f:
                    f.write(mgz)
                print(f'  Saved to {out_path}')
            except Exception as e:
                print(f'  gzip failed: {e}')
            try:
                mdecompressed = zlib.decompress(actual_data)
                print(f'  zlib success: {len(mdecompressed)} bytes')
            except Exception as e:
                print(f'  zlib failed: {e}')
    elif kind == 'dir':
        print(f'Dir: {name}')
    
    # Move to next entry
    if kind == 'file':
        pos = file_end
    else:
        pos += 512
    pos = (pos + 511) // 512 * 512

print(f'\nTotal files found: {len(found_files)}')
