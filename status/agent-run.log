import gzip, io, tarfile, struct

# Read the raw tar.gz file
with open('/tmp/test_toy.tar.gz', 'rb') as f:
    raw = f.read()

print(f'File size: {len(raw)} bytes')

# Try to find the gzip header and manually decompress up to the end-of-stream
# Gzip format: magic (2 bytes) + method (1 byte) + flags (1 byte) + mtime (4 bytes) + xfl (1 byte) + OS (1 byte)
# Then deflate data
# deflate ends when we get enough bytes or hit the checksum

# Let's try to use Python's incremental decompressor
import zlib

# Strip gzip header (10 bytes is the minimum)
try:
    dec = zlib.decompressobj(-zlib.MAX_WBITS)
    decompressed = dec.decompress(raw[10:])
    print(f'Decompressed {len(decompressed)} bytes after stripping 10-byte header')
except Exception as e:
    print(f'Decompress after header strip failed: {e}')
    # Try with different header sizes
    for header_size in [10, 18]:
        try:
            dec = zlib.decompressobj(-zlib.MAX_WBITS)
            decompressed = dec.decompress(raw[header_size:])
            print(f'Decompressed {len(decompressed)} bytes after {header_size}-byte header strip')
            break
        except Exception as e2:
            pass
