    raw = f.read()

dec = zlib.decompressobj(-zlib.MAX_WBITS)
decompressed = dec.decompress(raw[10:])

# Manual tar parsing
pos = 0
file_data_map = {}

while pos < len(decompressed):
    header = decompressed[pos:pos+512]
    if len(header) < 512:
        break
    name = header[0:100].rstrip(b'\x00').decode('utf-8', errors='replace')
    if name.strip() == '':
        break
    size = int(header[124:136].rstrip(b'\x00').decode('utf-8', errors='replace'), 8)
    typeflag = header[156:157] if len(header) > 156 else b''
    
    if typeflag == b'0' or typeflag == b'\0':
        kind = 'file'
    elif typeflag == b'5':
        kind = 'dir'
    else:
        kind = f'type={typeflag}'
    
    if kind == 'file':
        file_start = pos + 512
        file_blocks = (size + 511) // 512
        file_end = file_start + file_blocks * 512
        file_data = decompressed[file_start:file_end]
        if size % 512 != 0:
            actual_data = file_data[:-((512 - size % 512) % 512)]
        else:
            actual_data = file_data
        file_data_map[name] = actual_data
        bn = os.path.basename(name)
        print(f"  File: {bn} ({len(actual_data)} bytes)")
    elif kind == 'dir':
        print(f"  Dir: {name}")
    
    if kind == 'file':
        pos = file_end
    else:
        pos += 512
    pos = (pos + 511) // 512 * 512

# Decompress .gz files
print("\nDecompressing .gz files...")
for name, data in file_data_map.items():
    bn = os.path.basename(name)
    if bn.endswith('.gz'):
        try:
            mgz = gzip.decompress(data)
            out_name = bn[:-3]
            out_path = f"/tmp/long_{out_name}"
            with open(out_path, 'wb') as f:
                f.write(mgz)
            print(f"  Decompressed {bn} -> {out_name} ({len(mgz)} bytes)")
            if out_name.endswith('.fq') or out_name.endswith('.fastq'):
                text = mgz.decode('utf-8', errors='replace')[:200]
                print(f"    First 200 chars: {text}")
        except Exception as e:
            print(f"  Failed to decompress {bn}: {e}")
