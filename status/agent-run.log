with open('/vol/data/datasets/cami_III/cami3_toy_human_gut_short_read_sample_0.tar.gz', 'rb') as f:
    raw = f.read()

# Decompress what we can (skip 10-byte gzip header)
dec = zlib.decompressobj(-zlib.MAX_WBITS)
decompressed = dec.decompress(raw[10:])

print(f'Decompressed size: {len(decompressed)} bytes')
print(f'First 100 bytes: {decompressed[:100]}')
print(f'Last 100 bytes: {decompressed[-100:]}')

# Check if the decompressed data looks like a tar file
# Tar files start with a magic string
import os
# Check for 'ustar' at offset 257
if decompressed[257:263] == b'ustar':
    print('Valid ustar tar format detected')
else:
    print(f'Position 257-263: {decompressed[257:263]}')

# Try to create a new gzip file from the decompressed data
# First, compute CRC32 and ISIZE
crc = zlib.crc32(decompressed) & 0xFFFFFFFF
isize = len(decompressed) % (2**32)
print(f'CRC32: {crc}')
print(f'ISIZE: {isize}')

# Pack the footer: CRC32 (4 bytes little-endian) + ISIZE (4 bytes little-endian)
footer = struct.pack('<II', crc, isize)
print(f'Footer: {footer.hex()}')

# Create new gzip data: header + decompressed data + footer
# Gzip header: 1f 8b 08 00 (magic + method + flags) + mtime (4 bytes) + xfl (1 byte) + os (1 byte)
# Standard header: 1f 8b 08 00 00 00 00 00 00 03 (for Unix)
import array
header = b'\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\x03'
new_gzip_data = header + decompressed + footer

# Write the new file
with open('/vol/data/datasets/cami_III/cami3_toy_human_gut_short_read_sample_0.tar.gz.repaired', 'wb') as f:
    f.write(new_gzip_data)
print(f'Repaired file written: {len(new_gzip_data)} bytes')

# Test if the repaired file is valid
