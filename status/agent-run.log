def summarize(cs, ts):
    if not cs:
        return "", "", "", ""
    mean_c = sum(cs) / len(cs)
    mean_t = sum(ts) / len(ts) if ts else 0.0
    hq = sum(1 for c, t in zip(cs, ts) if c > 90 and t < 5)
    mq = sum(1 for c, t in zip(cs, ts) if c >= 50 and t < 10)
    return f"{mean_c:.2f}", f"{mean_t:.2f}", str(hq), str(mq)

