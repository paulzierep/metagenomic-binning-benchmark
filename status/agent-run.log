less specific type requested. marine_v11_20260925 run active at epoch 118/200.","createdAt":"2026-09-25T10:57:08Z","includesCreatedEdit":false,"isMinimized":false,"minimizedReason":"","reactionGroups":[],"url":"https://github.com/paulzierep/metagenomic-binning-benchmark/issues/12#issuecomment-5831252251","viewerDidAuthor":true}],"number":12,"state":"OPEN","title":"Improve reporting","updatedAt":"2026-09-25T10:57:08Z"}
