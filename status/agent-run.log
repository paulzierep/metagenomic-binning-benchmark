out = os.path.join(repo, "results", f"{name}.csv")

def meta_val(key):
    with open(meta) as f:
        for line in f:
            if line.startswith(key + ":"):
                return line.split(":", 1)[1].strip()
    return ""

commit = meta_val("commit")
t_total = meta_val("wall_s")
n_bins = meta_val("bins").split()[0] if meta_val("bins") else ""

