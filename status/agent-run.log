        idx = km.labels_
        save_result(idx, output_temp, namelist)

        gen_bins_from_tsv(contig_file, output_temp, output_temp+'_bins')

        time_end = time.time()
        logger.info("Running weighted seed-kmeans cost:\t"+str(time_end - time_start) + 's.')


