# ---- C7: disk ---------------------------------------------------------------- #
avail_kb=$(df -Pk /vol/data 2>/dev/null | awk 'NR==2{print $4}')
if [ -n "${avail_kb:-0}" ] && [ "$avail_kb" -gt 5242880 ]; then
  check C7_disk ok "$((avail_kb / 1024 / 1024)) GiB free"
else
