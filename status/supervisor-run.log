100	# modifed from https://github.com/BigDataBiology/SemiBin/blob/3bad22c58e710d8a5455f7411bc8d4202d557c61/SemiBin/generate_coverage.py#L5
   101	def calculate_coverage_samplebyindex(depth_file: str, augpredix: str, aug_seq_info_dict: dict, logger, edge: int = 0,
   102	                                     contig_threshold: int = 1000):
   103	    """
   104	    Calculate coverage from a position depth file for a set of contigs by index.
   105	
   106	    :param depth_file: Input position depth file generated from bedtools genomecov (str).
   107	    :param augpredix: Prefix used for generating output files (str).
   108	    :param aug_seq_info_dict: Dictionary containing information on contigs (dict).
   109	    :param edge: Number of bases to exclude from the edges of contigs (int, default: 0).
   110	    :param contig_threshold: Threshold for contig length, below which contigs are skipped (int, default: 1000).
   111	
   112	    :return: A tuple containing the input depth_file and logger (Tuple[str, logging.Logger).
   113	    """
   114	    contigs = []
   115	    mean_coverage = []
   116	
   117	    for contig_name, lines in groupby(open(depth_file), lambda ell: ell.split('\t', 1)[0]):
   118	        depth_value = []
   119	        for line in lines:
   120	            line_split = line.strip().split('\t')
   121	            length = int(float(line_split[2])) - int(float(line_split[1]))
   122	            value = int(float(line_split[3]))
   123	            depth_value.extend([value] * length)
   124	
   125	        cov_threshold = contig_threshold
   126	
   127	        if contig_name not in aug_seq_info_dict:
   128	            continue
   129	        if len(depth_value) <= cov_threshold:
   130	            continue
   131	        start = aug_seq_info_dict[contig_name][0]
   132	        end = aug_seq_info_dict[contig_name][1]
   133	
   134	        depth_value_ = depth_value[start + edge:end + 1 - edge]
   135	
   136	        mean = np.mean(depth_value_)
   137	        mean_coverage.append(mean)
   138	        contigs.append(contig_name)
   139	
   140	    contig_cov = pd.DataFrame(
   141	        {'{0}_cov'.format(depth_file): mean_coverage,
   142	         }, index=contigs)
   143	
   144	    with atomic_write(depth_file + '_' + augpredix + '_data_cov.csv', overwrite=True) as ofile:
   145	        contig_cov.to_csv(ofile, sep='\t')
   146	
   147	    return (depth_file, logger)
   148	
   149	
   150	def calculate_coverage(depth_file: str, logger, edge: int = 0,
   151	                       contig_threshold: int = 1000, sep: str = None,
   152	                       contig_threshold_dict: dict = None):
   153	    """
   154	    Calculate coverage based on a position depth file generated from mosdepth or bedtools genomecov.
   155	
   156	    :param depth_file: Path to the position depth file (str).
   157	    :param edge: Unused parameter, kept for compatibility (int, default: 0).
   158	    :param contig_threshold: Threshold of contigs for must-link constraints (int, default: 1000).
   159	    :param sep: Separator for multi-sample binning (str, default: None).
   160	    :param contig_threshold_dict: Dictionary of contig thresholds by sample (dict, default: None).
   161	
   162	    :return: None
   163	    """
   164	    contigs = []
   165	    mean_coverage = []
   166	
   167	    for contig_name, lines in groupby(open(depth_file), lambda ell: ell.split('\t', 1)[0]):
   168	        depth_value = []
   169	        for line in lines:
   170	            line_split = line.strip().split('\t')
   171	            length = int(float(line_split[2])) - int(float(line_split[1]))
   172	            value = int(float(line_split[3]))
   173	            depth_value.extend([value] * length)
   174	
   175	        if sep is None:
   176	            cov_threshold = contig_threshold
   177	        else:
   178	            sample_name = contig_name.split(sep)[0]
   179	            cov_threshold = contig_threshold_dict[sample_name]
   180	        if len(depth_value) <= cov_threshold:
   181	            continue
   182	
   183	        depth_value_ = depth_value
   184	
   185	        # modified
   186	        mean = np.mean(depth_value_)
   187	        mean_coverage.append(mean)
   188	        contigs.append(contig_name)
   189	
   190	    contig_cov = pd.DataFrame(
   191	        {'{0}_cov'.format(depth_file): mean_coverage,
   192	         }, index=contigs)
   193	
   194	    with atomic_write(depth_file + '_aug0_data_cov.csv', overwrite=True) as ofile:
   195	        contig_cov.to_csv(ofile, sep='\t')
   196	
   197	    return (depth_file, logger)
   198	
   199	
   200	def gen_cov_from_bedout(logger, out_path: str, depth_file_path: str,
   201	                        num_process: int = 10, num_aug: int = 5, edge: int = 0, contig_len: int = 1000):
   202	    """
   203	    Generate coverage data from bedtools output for original and augmented sequences.
   204	
   205	    :param out_path: Output directory for storing coverage files (str).
   206	    :param depth_file_path: Directory containing depth files (str).
   207	    :param num_process: Number of processes to run in parallel (int, default: 10).
   208	    :param num_aug: Number of augmented datasets (int, default: 5).
   209	    :param edge: Number of bases at contig edges to exclude (int, default: 0).
   210	    :param contig_len: Minimum contig length for inclusion (int, default: 1000).
   211	
   212	    :return: None
   213	    """
   214	    ########
   215	    filenames = os.listdir(depth_file_path)
   216	    namelist = []
   217	    for filename in filenames:
   218	        if filename.endswith('_depth.txt'):
   219	            namelist.append(filename)
   220	
   221	    namelist.sort()
   222	
   223	    pool = LoggingPool(num_process) if num_process != 0 else LoggingPool()
   224	    ##generate coverage for original data
   225	    for i in range(len(namelist)):
   226	        depth_file = depth_file_path + namelist[i]
   227	        pool.apply_async(
   228	            calculate_coverage,
   229	            args=(depth_file, logger, edge, contig_len),
   230	            callback=_checkback)
   231	
   232	    pool.close()
   233	    pool.join()
   234	
   235	    # merge coverage files
   236	    for nameid in range(len(namelist)):
   237	        cov_file = depth_file_path + namelist[
   238	            nameid] + '_aug0_data_cov.csv'
   239	        res_mat = pd.read_csv(cov_file, sep='\t', header=0, index_col=0)
   240	        if nameid == 0:
   241	            joined = res_mat
   242	        else:
   243	            joined = res_mat.join(joined, how="inner")
   244	
   245	    outfile = out_path + 'aug0_datacoverage_mean.tsv'
   246	    joined.to_csv(outfile, sep='\t', header=True)
   247	
   248	    for i in range(num_aug):
   249	        outdir = out_path + 'aug' + str(i + 1)
   250	        aug_seq_info_out_file = outdir + '/sequences_aug' + str(i + 1) + '.fasta' + '.aug_seq_info.tsv'
   251	        aug_seq_info_dict = read_aug_seq_info(aug_seq_info_out_file)
   252	
   253	        # num_process = 40
   254	        pool = LoggingPool(num_process) if num_process != 0 else LoggingPool()
   255	
   256	        ####generate coverage files
   257	        for nameid in range(len(namelist)):
   258	            depth_file = depth_file_path + namelist[nameid]
   259	            pool.apply_async(
   260	                calculate_coverage_samplebyindex,
   261	                args=(depth_file, 'aug' + str(i + 1), aug_seq_info_dict, logger, edge, contig_len),
   262	                callback=_checkback)
   263	
   264	        pool.close()
   265	        pool.join()
   266	
   267	        # merge coverage files
   268	        for nameid in range(len(namelist)):
   269	            cov_file = depth_file_path + namelist[
   270	                nameid] + '_aug' + str(i + 1) + '_data_cov.csv'
   271	
   272	            res_mat = pd.read_csv(cov_file, sep='\t', header=0, index_col=0)
   273	            if nameid == 0:
   274	                joined = res_mat
   275	            else:
   276	                joined = res_mat.join(joined, how="inner")
   277	
   278	        logger.info("Finish calculating coverage for aug_"+str(i+1))
   279	        outfile = out_path + 'aug' + str(i + 1) + '_datacoverage_mean.tsv'
   280	        joined.to_csv(outfile, sep='\t', header=True)
   281	
   282	
   283	def read_aug_seq_info(aug_seq_info_out_file):
   284	    aug_seq_info = pd.read_csv(aug_seq_info_out_file, sep='\t', header=0).values[:]
   285	    aug_seq_info_dict = {}
   286	    for i in range(len(aug_seq_info)):
   287	        aug_seq_info_dict[aug_seq_info[i][0]] = [aug_seq_info[i][1], aug_seq_info[i][2]]
   288	
   289	    return aug_seq_info_dict
   290	

