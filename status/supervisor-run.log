     1	#!/usr/bin/env bash
     2	# run_comebin_baseline.sh — run UNMODIFIED COMEBin on the demo dataset.
     3	# All inputs/outputs on /vol/data. Prints per-stage timing to stdout + log file.
     4	set -euo pipefail
     5	
     6	MM=/vol/data/tools/bin/micromamba
     7	ENV=/vol/data/envs/comebin
     8	SRC=/vol/data/repos/COMEBin
     9	DATA=/vol/data/datasets/comebin_test_data
    10	CONTIGS="$DATA/BATS_SAMN07137077_METAG.scaffolds.min500.fasta.f1k.fasta"
    11	BAMDIR="$DATA/bamfiles"
    12	RUNDIR=${1:-/vol/data/benchmark/runs/baseline_unmodified}
    13	THREADS=${THREADS:-32}
    14	
    15	mkdir -p "$RUNDIR"
    16	COMMIT=$(git -C "$SRC" rev-parse HEAD)
    17	DIRTY=$(git -C "$SRC" status --porcelain | wc -l)
    18	echo "source commit: $COMMIT (dirty files: $DIRTY)"
    19	[ "$DIRTY" -eq 0 ] || { echo "REFUSING: baseline source is modified; use pristine upstream"; exit 1; }
    20	{
    21	  echo "run:        $RUNDIR"
    22	  echo "date:       $(date -Is)"
    23	  echo "commit:     $COMMIT"
    24	  echo "contigs:    $CONTIGS"
    25	  echo "bamdir:     $BAMDIR"
    26	  echo "threads:    $THREADS"
    27	  echo "host:       $(nproc) cores, $(free -g | awk '/Mem:/{print $2}')G RAM, gpu=$(nvidia-smi -L 2>/dev/null || echo none)"
    28	  echo "cmd_wrapper: bash run_comebin.sh -a $CONTIGS -p $BAMDIR -o $RUNDIR/comebin_out -n 6 -t $THREADS  # via: micromamba run -p $ENV"
    29	} | tee "$RUNDIR/run_meta.txt"
    30	
    31	export MAMBA_ROOT_PREFIX=/vol/data/envs/.mamba
    32	cd "$SRC/COMEBin"   # upstream resolves ../auxiliary relative to CWD
    33	
    34	# register this run for the benchmark watchdog (scripts/benchmark-watchdog.sh)
    35	printf '%s %s %s %s %s\n' "$$" "$(ps -o pgid= -p $$ | tr -d ' ')" "$RUNDIR/comebin_run.log" "$RUNDIR" "$(date +%s)" > /vol/data/benchmark/.active_run
    36	
    37	# capture the real main.py train command once training starts (non-blocking)
    38	( sleep 12; MCMD=$(pgrep -af 'main.py' 2>/dev/null | head -1 | cut -d' ' -f2-); \
    39	  [ -n "$MCMD" ] && echo "cmd_train_py: $MCMD" >> "$RUNDIR/run_meta.txt" ) &
    40	
    41	START=$(date +%s)
    42	set +e
    43	CUDA_VISIBLE_DEVICES= "$MM" run -p "$ENV" bash run_comebin.sh \
    44	  -a "$CONTIGS" -p "$BAMDIR" -o "$RUNDIR/comebin_out" \
    45	  -n 6 -t "$THREADS" 2>&1 | tee "$RUNDIR/comebin_run.log"
    46	RC=${PIPESTATUS[0]}
    47	set -e
    48	END=$(date +%s)
    49	
    50	{
    51	  echo "exit_code:  $RC"
    52	  echo "wall_s:     $((END-START))"
    53	  echo "finished:   $(date -Is)"
    54	} | tee -a "$RUNDIR/run_meta.txt"
    55	
    56	if [ "$RC" -eq 0 ]; then
    57	  BINS="$RUNDIR/comebin_out/comebin_res/comebin_res_bins"
    58	  if [ -d "$BINS" ]; then
    59	    echo "bins: $(ls "$BINS" | wc -l)  -> $BINS" | tee -a "$RUNDIR/run_meta.txt"
    60	  fi
    61	fi
    62	# record helper-tool commands visible in the log (FragGeneScan/hmmsearch seed genes)
    63	grep -aE 'run_FragGeneScan|hmmsearch' "$RUNDIR/comebin_run.log" 2>/dev/null | head -2 \
    64	  | sed 's/^/cmd_from_log: /' | tee -a "$RUNDIR/run_meta.txt" >/dev/null || true
    65	exit "$RC"
