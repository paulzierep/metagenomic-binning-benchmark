   286	    ## training
   287	    if args.subcmd == 'train':
   288	        logger.info('train')
   289	        train_CLmodel(logger,args)
   290	
   291	    ## clustering
   292	    if args.subcmd == 'bin':
   293	        logger.info('bin')
   294	        from utils import gen_seed
   295	
   296	        num_threads = args.num_threads
   297	        _ = gen_seed(logger, args.contig_file, num_threads, args.contig_len, marker_name="bacar_marker", quarter="2quarter")
   298	
   299	        cluster(logger, args)
   300	
   301	
   302	    ## clustering NoContrast
   303	    if args.subcmd == 'nocontrast':
