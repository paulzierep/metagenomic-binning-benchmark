   255	def main():
   256	    """
   257	    The main function of the COMEBin program.
   258	
   259	    Functionality:
   260	        - Initializes logging for the program.
   261	        - Executes different subcommands based on user input.
   262	        - Subcommands include: 'train', 'bin', 'nocontrast', 'generate_aug_data', and 'get_result'.
   263	        - Subcommands perform various tasks such as data augmentation, training and clustering.
   264	    """
   265	    args = arguments()
   266	
   267	    # logging
   268	    logger = logging.getLogger('COMEBin\t'+ver)
   269	    logger.setLevel(logging.INFO)
   270	
   271	    formatter = logging.Formatter('%(asctime)s - %(message)s')
   272	    console_hdr = logging.StreamHandler()
