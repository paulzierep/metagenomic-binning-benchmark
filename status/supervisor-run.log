  [ -f "$src" ] || continue
  job=$(basename "$src"); case "$job" in __pycache__|*.pyc|*.pyo) continue ;; esac
  cmp -s "$src" "$BENCH/bin/$job" || bad="$bad $job"
done
[ -z "$bad" ] && echo "C1b_deploy ok — all repo/scripts identical in bin" || echo "C1b MISMATCH:$bad"
