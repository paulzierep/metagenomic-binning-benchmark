+        ("comebin_medium", "comebin_medium (3,000 contigs)"),
+        ("comebin_small", "comebin_small (300 contigs)"),
+        ("cami2", "CAMI II"),
+        ("cami3", "CAMI III"),
+    ]
+    for key, label in known:
+        if key in contigs_path:
+            return label
+    return os.path.basename(os.path.dirname(contigs_path))
