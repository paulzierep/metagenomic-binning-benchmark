   321	        outfile = args.output_path+'/compositMat/compositMat_feature.tsv'
   322	        compositMat_df.to_csv(outfile, sep='\t', header=True)
   323	
   324	        logger.info('NoContrast mode: generate features (aug0)')
   325	        ori_outpath = args.output_path
   326	
   327	        logger.info('NoContrast mode (combine) bin')
   328	        args.output_path = ori_outpath +'/combine_novars'
   329	        args.emb_file = args.output_path+'/combine_feature.tsv'
