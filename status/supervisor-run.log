orphan=""
for installed in "$BENCH"/bin/*; do
  [ -f "$installed" ] || continue
  job=$(basename "$installed")
  case "$job" in .*|__pycache__|*.pyc|*.pyo) continue ;; esac
  [ -f "$REPO/scripts/$job" ] || orphan="$orphan $job"
done
if [ -n "$orphan" ]; then echo "C1c_unsourced_bin degraded:$orphan"; else echo "C1c_unsourced_bin ok — every installed bin script has source in repo/scripts"; fi
echo "--- C1b reverse direction (repo->bin) ---"
bad=""
