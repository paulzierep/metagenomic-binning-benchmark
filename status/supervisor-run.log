     7	#   4. status/agent-activity.log — VERBOSE agent action log (agent appends lines)
     8	#   +  runs/<run>/           — per-run detailed logs synced from /vol/data/benchmark/runs/
     9	#   +  status/agent-run.log  — FULL transcript of every `opencode run` (all agent
    10	#                              commands, tool results, "Turn complete" summaries)
