     7	def get_kmer_coverage(data_path: str, n_views: int = 2, kmer_model_path: str = 'empty',
     8	                      device = torch.device('cpu'), nokmer: bool = False, cov_meannormalize: bool = False,
     9	                      cov_minmaxnormalize: bool = False, cov_standardization: bool = False, addvars: bool = False,
    10	                      vars_sqrt: bool = False, kmer_l2_normalize: bool = False, kmerMetric_notl2normalize: bool = False):
    11	    """
    12	    Get features
    13	
    14	    :param data_path: The path to the data directory.
    15	    :param n_views: The number of views (default: 2).
    16	    :param kmer_model_path: The path to the k-mer model (default: 'empty').
    17	    :param device: The device for computation (default: 'cpu').
    18	    :param nokmer: Flag to exclude k-mer data (default: False).
    19	    :param cov_meannormalize: Flag to mean normalize coverage data (default: False).
    20	    :param cov_minmaxnormalize: Flag to min-max normalize coverage data (default: False).
    21	    :param cov_standardization: Flag to standardize coverage data (default: False).
    22	    :param addvars: Flag to include additional variables (default: False).
    23	    :param vars_sqrt: Flag to take the square root of variables (default: False).
    24	    :param kmer_l2_normalize: Flag to L2 normalize k-mer data (default: False).
    25	    :param kmerMetric_notl2normalize: Flag to not L2 normalize k-mer metric data (default: False).
    26	
    27	    :return: A list of preprocessed data and a list of contig names.
    28	    """
    29	    namelist = pd.read_csv(data_path + 'aug0_datacoverage_mean.tsv', sep='\t', usecols=range(1)).values[:, 0]
    30	
    31	    mapObj = dict(zip(namelist, range(len(namelist))))
    32	    for view in range(n_views):
    33	        cov_file = data_path + 'aug' + str(view) + '_datacoverage_mean.tsv'
    34	        if not nokmer:
    35	            com_file = data_path + 'aug' + str(view) + '/kmer_4_f0.csv'
    36	
    37	        covHeader = pd.read_csv(cov_file, sep='\t', nrows=1)
    38	        shuffled_covMat = pd.read_csv(cov_file, sep='\t', usecols=range(1, covHeader.shape[1])).values
    39	        shuffled_namelist = pd.read_csv(cov_file, sep='\t', usecols=range(1)).values[:, 0]
    40	
    41	        covIdxArr = np.zeros(len(mapObj), dtype=np.int)
    42	        for contigIdx in range(len(shuffled_namelist)):
    43	            if shuffled_namelist[contigIdx].split('_aug')[0] in mapObj:
    44	                covIdxArr[mapObj[shuffled_namelist[contigIdx].split('_aug')[0]]] = contigIdx
    45	        covMat = shuffled_covMat[covIdxArr]
    46	
    47	
    48	        if not nokmer:
    49	            compositHeader = pd.read_csv(com_file, sep=',', nrows=1)
    50	            shuffled_compositMat = pd.read_csv(com_file, sep=',', usecols=range(1, compositHeader.shape[1])).values
    51	            shuffled_namelist = pd.read_csv(com_file, sep=',', usecols=range(1)).values[:, 0]
    52	
    53	            covIdxArr = np.zeros(len(mapObj), dtype=np.int)
    54	            for contigIdx in range(len(shuffled_namelist)):
    55	                if shuffled_namelist[contigIdx].split('_aug')[0] in mapObj:
    56	                    covIdxArr[mapObj[shuffled_namelist[contigIdx].split('_aug')[0]]] = contigIdx
    57	            compositMat = shuffled_compositMat[covIdxArr]
    58	
    59	        if addvars:
    60	            vars_file = data_path+'aug'+str(view)+'_datacoverage_var.tsv'
    61	
    62	            varsHeader = pd.read_csv(vars_file, sep='\t', nrows=1)
    63	            shuffled_varsMat = pd.read_csv(vars_file, sep='\t', usecols=range(1, varsHeader.shape[1])).values
    64	            shuffled_namelist = pd.read_csv(vars_file, sep='\t', usecols=range(1)).values[:, 0]
    65	
    66	            covIdxArr = np.zeros(len(mapObj), dtype=np.int)
    67	            for contigIdx in range(len(shuffled_namelist)):
    68	                if shuffled_namelist[contigIdx].split('_aug')[0] in mapObj:
    69	                    covIdxArr[mapObj[shuffled_namelist[contigIdx].split('_aug')[0]]] = contigIdx
    70	            varsMat = shuffled_varsMat[covIdxArr]
    71	
    72	        if view == 0:
    73	            covMats = covMat
    74	            if addvars:
    75	                varsMats = varsMat
    76	            if not nokmer:
    77	                compositMats = compositMat
    78	
    79	        else:
    80	            covMats = np.vstack((covMats, covMat))
    81	            if addvars:
    82	                varsMats = np.vstack((varsMats, varsMat))
    83	            if not nokmer:
    84	                compositMats = np.vstack((compositMats, compositMat))
    85	
    86	    # use cov_maxnormalize
    87	    covMats = covMats + 1e-5
    88	    if addvars:
    89	        if vars_sqrt:
    90	            varsMats = np.sqrt(varsMats)
    91	        varsMats = varsMats + 1e-5
    92	
    93	    if cov_meannormalize:
    94	        covMats = covMats / covMats.mean(axis=0)[None, :]
    95	        if addvars:
    96	            varsMats = varsMats / varsMats.mean(axis=0)[None, :]
    97	
    98	    elif cov_minmaxnormalize:
    99	        covMats = (covMats - covMats.min(axis=0)[None, :])/ (covMats.max(axis=0)[None, :] - covMats.min(axis=0)[None, :] )
   100	        if addvars:
   101	            varsMats = (varsMats - varsMats.min(axis=0)[None, :])/ (varsMats.max(axis=0)[None, :] - varsMats.min(axis=0)[None, :] )
   102	
   103	    elif cov_standardization:
   104	        covMats = (covMats - covMats.mean(axis=0)[None, :])/ covMats.std(axis=0)[None, :]
   105	        if addvars:
   106	            varsMats = (varsMats - varsMats.mean(axis=0)[None, :])/ varsMats.std(axis=0)[None, :]
   107	    else:
   108	        covMats = covMats / covMats.max(axis=0)[None, :]
   109	        if addvars:
   110	            varsMats = varsMats / varsMats.max(axis=0)[None, :]
   111	
   112	    if not nokmer:
   113	        compositMats = compositMats + 1
   114	        compositMats = compositMats / compositMats.sum(axis=1)[:, None]
   115	        if kmer_l2_normalize:
   116	            compositMats = normalize(compositMats)
   117	        if kmer_model_path != 'empty':
   118	            compositMats = get_kmerMetric_emb(kmer_model_path, compositMats, device,kmerMetric_notl2normalize)
   119	
   120	    if not nokmer:
   121	        X_ts = np.hstack((covMats, compositMats))
   122	    else:
   123	        X_ts = covMats
   124	
   125	    if addvars:
   126	        X_ts = np.hstack((varsMats, X_ts))
   127	
   128	    return list(torch.split(torch.from_numpy(X_ts).float(), len(namelist))), namelist
