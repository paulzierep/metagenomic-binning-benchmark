1	from Bio import SeqIO
     2	import mimetypes
     3	import os
     4	import gzip
     5	import random
     6	import shutil
     7	from typing import Dict
     8	
     9	
    10	def get_inputsequences(fastx_file: str):
    11	    """
    12	    Retrieve sequences from a FASTX file and return them as a dictionary.
    13	
    14	    :param fastx_file: Path to the FASTX file (either FASTA or FASTQ).
    15	    :return: A dictionary where sequence IDs are keys and sequences are values.
    16	    """
    17	    file_type = mimetypes.guess_type(fastx_file)[1]
    18	    if file_type == 'gzip':
    19	        f = gzip.open(fastx_file, "rt")
    20	    elif not file_type:
    21	        f = open(fastx_file, "rt")
    22	    else:
    23	        raise RuntimeError("Unknown type of file: '{}".format(fastx_file))
    24	    seqs = {}
    25	    if os.path.getsize(fastx_file) == 0:
    26	        return seqs
    27	    file_format = None
    28	    line = f.readline()
    29	    if line.startswith('@'):
    30	        file_format = "fastq"
    31	    elif line.startswith(">"):
    32	        file_format = "fasta"
    33	    f.seek(0)
    34	    if not file_format:
    35	        raise RuntimeError("Invalid sequence file: '{}".format(fastx_file))
    36	    for seq_record in SeqIO.parse(f, file_format):
    37	        seqs[seq_record.id] = seq_record.seq
    38	
    39	    f.close()
    40	    return seqs
    41	
    42	
    43	def gen_augfasta(seqs: Dict[str, str], augprefix: str, out_file: str,
    44	                 p: float = None, contig_len: int = 1000):
    45	    """
    46	    Generate augmented sequences and save them to a FASTA file along with sequence information.
    47	
    48	    :param seqs: A dictionary of input sequences where keys are sequence IDs, and values are sequences.
    49	    :param augprefix: A prefix used in the augmented sequence IDs.
    50	    :param out_file: Path to the output FASTA file.
    51	    :param p: Proportion of the original sequence to include in the augmented sequences (default is None).
    52	    :param contig_len: Minimum length of the original sequence required for augmentation (default is 1000).
    53	    """
    54	    seqkeys = []
    55	    for seqid in seqs.keys():
    56	        if len(seqs[seqid]) >= contig_len + 1:
    57	            seqkeys.append(seqid)
    58	
    59	    aug_seq_info = []
    60	    if not p:
    61	        with open(out_file, 'w') as f:
    62	            for seqid in seqkeys:
    63	                start = random.randint(0, len(seqs[seqid]) - (contig_len+1))
    64	                sim_len = random.randint(contig_len, len(seqs[seqid]) - start)
    65	                end = start + sim_len - 1
    66	                # gen_seqs_dict[genome_name+"_sim_"+str(sim_count)] =seqs[seqid][start:end+1]
    67	                sequence = str(seqs[seqid][start:end + 1])
    68	                seqid_name = ">" + seqid + "_" + str(augprefix)
    69	                f.write(seqid_name + "\n")
    70	                f.write(sequence + "\n")
    71	                aug_seq_info.append((seqid, start, end, sim_len))
    72	    else:
    73	        with open(out_file, 'w') as f:
    74	            for seqid in seqkeys:
    75	                sim_len = int(p * len(seqs[seqid]))
    76	                start = random.randint(0, len(seqs[seqid]) - sim_len - 10)
    77	                end = start + sim_len - 1
    78	                # gen_seqs_dict[genome_name+"_sim_"+str(sim_count)] =seqs[seqid][start:end+1]
    79	                sequence = str(seqs[seqid][start:end + 1])
    80	                seqid_name = ">" + seqid + "_aug_" + str(augprefix)
    81	                f.write(seqid_name + "\n")
    82	                f.write(sequence + "\n")
    83	                aug_seq_info.append((seqid, start, end, sim_len))
    84	
    85	    aug_seq_info_out_file = out_file + '.aug_seq_info.tsv'
    86	
    87	    with open(aug_seq_info_out_file, 'w') as afile:
    88	        afile.write('seqid\tstart\tend\tlength\n')
    89	        for i in range(len(aug_seq_info)):
    90	            afile.write(
    91	                aug_seq_info[i][0] + '\t' + str(aug_seq_info[i][1]) + '\t' + str(aug_seq_info[i][2]) + '\t' + str(
    92	                    aug_seq_info[i][3]) + '\n')
    93	
    94	
    95	def run_gen_augfasta(logger, args):
    96	    """
    97	    Generate augmentation fasta file and save index
    98	    """
    99	    num_aug = args.n_views - 1  # Generate several copies of augmented data
   100	    fasta_file = args.contig_file
   101	    out_path = args.out_augdata_path
   102	    contig_len = args.contig_len
   103	
   104	    outdir = out_path + '/aug0'
   105	    os.makedirs(outdir)
   106	    out_file = outdir + '/sequences_aug0.fasta'
   107	    shutil.copyfile(fasta_file, out_file)
   108	
   109	    from .gen_kmer import run_gen_kmer
   110	    run_gen_kmer(out_file, 0, 4)
   111	
   112	    for i in range(num_aug):
   113	        outdir = out_path + '/aug' + str(i + 1)
   114	        os.makedirs(outdir)
   115	        logger.info("aug:\t" + str(i+1))
   116	        p = None
   117	        seqs = get_inputsequences(fasta_file)
   118	
   119	        out_file = outdir + '/sequences_aug' + str(i + 1) + '.fasta'
   120	        gen_augfasta(seqs, 'aug' + str(i + 1), out_file, p=p, contig_len=contig_len)
   121	        run_gen_kmer(out_file, 0, 4)

