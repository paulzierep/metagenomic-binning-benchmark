   131	def get_ContrastiveLearningDataset(data_path: str, n_views: int = 2, kmer_model_path: str = 'empty',
   132	                                   device=torch.device('cpu'), nokmer: bool = False, cov_meannormalize: bool = False,
   133	                                   cov_minmaxnormalize: bool = False, cov_standardization: bool = False, addvars: bool = False,
   134	                                   vars_sqrt: bool = False, kmer_l2_normalize: bool = False, kmerMetric_notl2normalize: bool = False):
   135	    """
   136	    Get a Contrastive Learning dataset based on input parameters.
   137	
   138	    :param data_path: The path to the data.
   139	    :param n_views: The number of views for data (default: 2).
   140	    :param kmer_model_path: The path to the k-mer model (default: 'empty').
   141	    :param device: The device to use for computations (default: 'cpu').
   142	    :param nokmer: Whether to use k-mer features (default: False).
   143	    :param cov_meannormalize: Whether to mean normalize coverage (default: False).
   144	    :param cov_minmaxnormalize: Whether to min-max normalize coverage (default: False).
   145	    :param cov_standardization: Whether to standardize coverage (default: False).
   146	    :param addvars: Whether to add additional variables (default: False).
   147	    :param vars_sqrt: Whether to take the square root of additional variables (default: False).
   148	    :param kmer_l2_normalize: Whether to L2 normalize k-mer features (default: False).
   149	    :param kmerMetric_notl2normalize: Whether not to L2 normalize k-mer features (default: False).
   150	
   151	    :return: A tuple containing the dataset and a list of names.
   152	    """
   153	    if not data_path.endswith('/'):
   154	        data_path = data_path + '/'
   155	    dataset, namelist = get_kmer_coverage(data_path, n_views, kmer_model_path, device, nokmer, cov_meannormalize, cov_minmaxnormalize, cov_standardization,addvars,vars_sqrt,kmer_l2_normalize,kmerMetric_notl2normalize)
   156	    return dataset, namelist

