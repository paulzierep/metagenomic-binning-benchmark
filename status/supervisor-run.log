   305	        from utils import get_kmer_coverage_aug0
   306	
   307	        X_t, covMat, compositMat, namelist = get_kmer_coverage_aug0(args.data)
   308	
   309	        X_t_df = pd.DataFrame(X_t, index=namelist)
   310	        os.makedirs(args.output_path+'/combine_novars', exist_ok=True)
   311	        outfile = args.output_path+'/combine_novars/combine_feature.tsv'
   312	        X_t_df.to_csv(outfile, sep='\t', header=True)
   313	
   314	        covMat_df = pd.DataFrame(covMat, index=namelist)
   315	        os.makedirs(args.output_path+'/covMat', exist_ok=True)
   316	        outfile = args.output_path+'/covMat/covMat_feature.tsv'
