Now I'll apply the singleton-guard fix to the sweep driver (via atomic rename, since it is currently executing) and add a duplicate-driver check to the meta-watchdog.
$ set -e
SRC=/vol/data/repos/metagenomic-binning-benchmark/scripts/run_sweep_medium.sh
TMP=/tmp/opencode/run_sweep_medium.new
mkdir -p /tmp/opencode
awk '
/^log\(\) \{ echo "\[\$\(date -u \+%FT%TZ\)\] \$\*" \| tee -a "\$LOG"; \}$/ {
  print
  print ""
  print "# ---- singleton guard: exactly one sweep driver may exist ---------------- #"
  print "# The sweep drives one COMEBin cell at a time against shared state: the run"
  print "# slot (.active_run), /tmp/benchmark-start.lock and one log. A second instance"
  print "# does not queue politely - it walks the same cell list concurrently,"
  print "# clobbers .active_run, and its cells collide with the first instance'"'"'s."
  print "# That is how the 13:07 launch ended up with three drivers, and how the live"
  print "# cell was orphaned (its parent driver died, the child kept training under"
  print "# init) instead of being supervised. Same shape as the agent-watchdog and"
  print "# benchmark-watchdog guards: flock for new-vs-new, plus a process scan so an"
  print "# instance started BEFORE this guard existed is still honoured, not raced."
  print "SWEEP_LOCK=${SWEEP_LOCK:-/tmp/run_sweep_medium.lock}"
  print "exec 9>\"$SWEEP_LOCK\""
  print "if ! flock -n 9; then"
  print "  echo \"another sweep driver holds $SWEEP_LOCK\" >&2"
  print "  exit 0"
  print "fi"
  print "for other in $(pgrep -f \x27run_sweep_medium\\.sh\x27 2>/dev/null || true); do"
  print "  [ \"$other\" = \"$$\" ] && continue"
  print "  [ \"$other\" = \"$PPID\" ] && continue"
  print "  log \"ABORT: sweep driver pid=$other already running; singleton guard, not starting a second\""
  print "  exit 0"
  print "done"
  print ""
  next
}
{ print }
' "$SRC" > "$TMP"
