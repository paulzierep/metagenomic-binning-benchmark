        # CheckM v1 bin_stats_ext.tsv is '<bin-id>\\t<dict literal>' per line.
        lines = [first, *f] if is_dict_row else f
        for line in lines:
            p = line.rstrip("\n").split("\t", 1)
            if len(p) != 2:
