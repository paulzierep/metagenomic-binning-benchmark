    14	#   - heartbeat fresh            -> "alive: yes" + /vol/data/benchmark/.activity
    15	#   - heartbeat stale            -> "alive: no — watchdog will restart within ~5 min"
    16	#   - TASK_COMPLETE exists       -> "alive: no — task done"
