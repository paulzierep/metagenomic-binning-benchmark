1	#!/usr/bin/env bash
     2	# agent-watchdog.sh — keep the OpenCode agent working on the benchmark task.
     3	#
     4	# WHY THIS FILE EXISTS / WHAT CHANGED (2026-09-23):
     5	#   `opencode run --auto` is a SINGLE-TURN command in v2: it sends the prompt,
     6	#   the agent completes ONE assistant turn, prints "Turn complete" and exits 0.
     7	#   The old design launched one run per cron tick and then waited for the
     8	#   heartbeat to go stale — so the agent effectively never got more than one
     9	#   turn per ~20 min, and after 6 launches it hit the crash-loop rate limit
    10	#   and stayed stopped for hours ("agent is always stopped").
    11	#
    12	#   Now the watchdog drives a PERSISTENT LOOP (see run_driver below): each
    13	#   cron invocation that finds the agent idle starts a driver that keeps
    14	#   calling `opencode run --auto --session <id>` — one turn per call, same
    15	#   session, so context carries over — until the task is done, the agent
    16	#   crashes, or a hard time/turn budget is hit. A flock guarantees only ONE
    17	#   driver exists at a time; the next cron tick just skips while it's alive.
    18	#
    19	# Full documentation: docs/05-agent-restart.md
    20	# Design doc / resume state: /vol/data/benchmark/PROGRESS.md
    21	set -u
    22	export HOME=/home/ubuntu
    23	export PATH=/home/ubuntu/.opencode/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
    24	cd /home/ubuntu || exit 1
    25	
    26	BENCH=/vol/data/benchmark
    27	HEARTBEAT="$BENCH/.heartbeat"
    28	LOG="$BENCH/logs/watchdog.log"
    29	AGENT_LOG="$BENCH/logs/agent-run.log"   # stdout/stderr of `opencode run` attempts
    30	ATTDIR="$BENCH/.watchdog_attempts"
    31	STATUS="$BENCH/.watchdog_last_status"
    32	MODELIX="$BENCH/.watchdog_model_ix"
    33	FORCE_MODEL="$BENCH/.watchdog_force_model"
    34	COMPLETE="$BENCH/TASK_COMPLETE"
    35	LOCK=/tmp/agent-watchdog.lock
    36	SESSION_ID="ses_f31799c77ffeTq9gcYgqc4hBhg"
    37	STALE_S=900            # heartbeat/transcript older than 15 min => agent presumed idle
    38	RUN_STALE_S=1500       # ...and no `opencode run` process alive
    39	WINDOW_MIN=360         # crash-loop rate-limit window
    40	MAX_ATTEMPTS=6         # max driver LAUNCHES per window
    41	MAX_TURNS=200          # hard cap per driver (avoids a runaway forever-loop)
    42	MAX_RUNTIME_S=28800    # hard cap per driver: 8 h; next cron tick relaunches
    43	TURN_GAP_S=30          # pause between turns
    44	IDLE_GAP_S=600         # longer pause when the agent says it is waiting/idle
    45	QUOTA_RETRIES=3        # consecutive quota-limited runs before giving up to cron
    46	
    47	# Free models, tried in order when the default model is quota-limited.
    48	FREE_MODELS=(
    49	  "opencode/mimo-v2.6-flash-free"
    50	  "opencode/muse-spark-1.3-contributor-free"
    51	  "opencode/ling-3.0-flash-fin-free"
    52	  "opencode/nemotron-3.5-lightning-free"
    53	)
    54	
    55	mkdir -p "$BENCH/logs" "$ATTDIR"
    56	log() { echo "$(date -Is) [watchdog] $*" >>"$LOG"; }
    57	
    58	[ -f "$COMPLETE" ] && exit 0
    59	
    60	# ---- single driver at a time ---------------------------------------------- #
    61	exec 9>"$LOCK"
    62	flock -n 9 || { log "skipped: another driver holds the lock"; exit 0; }
    63	
    64	# ---- is the agent already alive? ------------------------------------------ #
    65	hb_age=999999
    66	[ -f "$HEARTBEAT" ] && hb_age=$(( $(date +%s) - $(stat -c %Y "$HEARTBEAT") ))
    67	tl_age=999999
    68	[ -f "$AGENT_LOG" ] && tl_age=$(( $(date +%s) - $(stat -c %Y "$AGENT_LOG") ))
    69	run_alive=0
    70	pgrep -f "opencode run --auto" >/dev/null 2>&1 && run_alive=1
    71	
    72	alive=0
    73	[ "$run_alive" = "1" ] && alive=1
    74	[ "$hb_age" -lt "$STALE_S" ] && alive=1
    75	[ "$tl_age" -lt "$STALE_S" ] && alive=1
    76	[ "$alive" = "1" ] && exit 0   # agent working (or a run in flight), nothing to do
    77	
    78	# ---- crash-loop guard (counts DRIVER LAUNCHES, not turns) ------------------- #
    79	n=$(find "$ATTDIR" -type f -mmin "-$WINDOW_MIN" 2>/dev/null | wc -l)
    80	if [ "$n" -ge "$MAX_ATTEMPTS" ]; then
    81	    log "rate-limited: $n launches in last ${WINDOW_MIN}min, not restarting"
    82	    exit 0
    83	fi
    84	
    85	# ---- classify the previous run's failure (if any) -------------------------- #
    86	last=0
    87	[ -f "$STATUS" ] && last=$(cat "$STATUS" 2>/dev/null || echo 0)
    88	quota=0
    89	if [ "$last" != "0" ] && [ -f "$AGENT_LOG" ]; then
    90	    if tail -c 200000 "$AGENT_LOG" 2>/dev/null | grep -Eiq \
    91	        'rate.?limit|quota|too many requests|429|token[s]? (are |is )?(exhausted|exceeded)|context.{0,20}(length|window).{0,20}(exceed|too long)|insufficient.{0,10}credit'; then
    92	        quota=1
    93	        log "previous failure looks like quota/context exhaustion"
    94	    fi
    95	fi
    96	
    97	# ---- pick start model ------------------------------------------------------- #
    98	MODEL_ARGS=()
    99	if [ "$quota" = "1" ]; then
   100	    ix=0
   101	    [ -f "$MODELIX" ] && ix=$(cat "$MODELIX" 2>/dev/null || echo 0)
   102	    pick="${FREE_MODELS[$(( ix % ${#FREE_MODELS[@]} ))]}"
   103	    echo $(( (ix + 1) % ${#FREE_MODELS[@]} )) >"$MODELIX"
   104	    MODEL_ARGS=(--model "$pick")
   105	    touch "$FORCE_MODEL"
   106	    log "forcing free model: $pick"
   107	elif [ "$last" = "0" ]; then
   108	    rm -f "$FORCE_MODEL"   # healthy run -> default model
   109	elif [ -f "$FORCE_MODEL" ]; then
   110	    ix=0
   111	    [ -f "$MODELIX" ] && ix=$(cat "$MODELIX" 2>/dev/null || echo 0)
   112	    pick="${FREE_MODELS[$(( ix % ${#FREE_MODELS[@]} ))]}"
   113	    echo $(( (ix + 1) % ${#FREE_MODELS[@]} )) >"$MODELIX"
   114	    MODEL_ARGS=(--model "$pick")
   115	    log "rotating free model after failure: $pick"
   116	fi
   117	
   118	# ---- launch ONE driver (it loops turns itself) ------------------------------ #
   119	# Count a launch toward the crash-loop budget only after a FAILED run, so
   120	# healthy steady-state relaunches never accumulate markers (issue #4 fix).
   121	[ "$last" = "0" ] || touch "$ATTDIR/$(date +%s)"
   122	age=$(( hb_age < tl_age ? hb_age : tl_age ))
