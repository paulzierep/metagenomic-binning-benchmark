# never commit large/raw benchmark artifacts — only parsed tables go to results/
*.bam
*.bai
*.fasta
*.fa
*.fna
*.zip
*.pth.tar
*.hmmout
*.frag.*
__pycache__/
.DS_Store

# local run dirs accidentally created inside the repo
# NOTE: per-run DETAILED LOGS ARE TRACKED in the repo (runs/<run>/, synced by the
# status-heartbeat every 10 min + at run end). Only the small log files are
# committed; raw artifacts (models, augmented data/kmer tables, bins, bams) stay
# on disk under /vol/data/benchmark/runs/.
runs/*
!runs/*/
!runs/README.md
!runs/*/run_meta.txt
!runs/*/comebin_run.log
!runs/*/logs/
!runs/*/logs/resources.tsv
!runs/*/logs/sampler.out
!runs/*/comebin_res/
!runs/*/comebin_res/comebin.log
!runs/*/comebin_res/training.log
!runs/*/comebin_res/config.yml
comebin_out/
eval_out/
